[Unit]
Description=utter context-aware voice -> desktop action daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# @REPO@ = your checkout path (see docs/CUSTOMISING.md).
# The wrapper discovers WAYLAND_DISPLAY / DBUS_SESSION_BUS_ADDRESS / NIRI_SOCKET
# and XDG_RUNTIME_DIR, then execs `python -m utter.daemon` (same as the runner).
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/utter-daemon-ready.sh
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
