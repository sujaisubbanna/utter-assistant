[Unit]
Description=ydotool input injection daemon (utter)
Documentation=man:ydotoold(8)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ydotoold --socket-path=%t/.ydotool_socket --socket-perm=0600
Restart=always
RestartSec=1
# %t = the user's XDG_RUNTIME_DIR; clients must set
# YDOTOOL_SOCKET=%t/.ydotool_socket (utter does this automatically).

[Install]
WantedBy=default.target
