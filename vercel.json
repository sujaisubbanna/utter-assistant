{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd website && corepack pnpm@10.0.0 install --frozen-lockfile",
  "buildCommand": "cd website && corepack pnpm@10.0.0 build",
  "outputDirectory": "website/dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/utter-assistant", "destination": "/", "permanent": true },
    { "source": "/utter-assistant/:path*", "destination": "/:path*", "permanent": true }
  ]
}
