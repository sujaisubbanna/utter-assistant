#!/usr/bin/env python3
"""utter-gui launcher.

Runs the GTK4 + libadwaita settings window. If the interpreter that started this
file cannot import ``gi``/GTK4/libadwaita, we re-exec with a Python that can
(``$UTTER_PYTHON``, the repo's ``.venv-agent``, or the system python3).
"""
from __future__ import annotations

import os
import shutil
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)


def _has_gtk() -> bool:
    try:
        import gi  # noqa: F401

        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
        from gi.repository import Gtk, Adw  # noqa: F401
        return True
    except Exception:  # noqa: BLE001
        return False


def _candidates() -> list[str]:
    found: list[str] = []
    env = os.environ.get("UTTER_PYTHON")
    if env:
        found.append(env)
    found.append(os.path.join(REPO, ".venv-agent", "bin", "python"))
    found.append(os.path.join(REPO, ".venv", "bin", "python"))
    found.append(sys.executable)
    system = shutil.which("python3")
    if system:
        found.append(system)
    return found


def _reexec() -> None:
    me = os.path.abspath(__file__)
    current = os.path.abspath(sys.executable)
    for candidate in _candidates():
        if not candidate or not os.path.exists(candidate):
            continue
        if os.path.abspath(candidate) == current:
            continue
        os.execv(candidate, [candidate, me, *sys.argv[1:]])


def main() -> int:
    if not _has_gtk():
        _reexec()
        sys.stderr.write(
            "utter-gui: no Python with PyGObject, GTK4 and libadwaita found\n"
        )
        return 1
    if HERE not in sys.path:
        sys.path.insert(0, HERE)
    from utter_gui.app import main as app_main

    return app_main(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
