#!/usr/bin/env bash
# utter-gui — launch the Tauri settings app.
#
# The Noctalia widget's left-click calls `utter-gui` (right-click refreshes
# status). This wrapper finds the built binary, points the app at this checkout
# and works around a WebKitGTK/dual-NVIDIA issue on Wayland.
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd -- "$HERE/.." && pwd)"
SRC_TAURI="$HERE/src-tauri"

# Dual NVIDIA on Wayland: the DMABUF renderer produces a blank/garbled buffer.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
# Let the app find `assistant`, config and the runner socket for this checkout.
export UTTER_REPO="${UTTER_REPO:-$REPO}"

binary=""
for candidate in \
  "$SRC_TAURI/target/release/utter" \
  "$SRC_TAURI/target/debug/utter"; do
  if [[ -x "$candidate" ]]; then
    binary="$candidate"
    break
  fi
done

if [[ -z "$binary" ]]; then
  if [[ "${UTTER_GUI_NO_BUILD:-0}" == "1" ]]; then
    echo "utter-gui: no binary built yet." >&2
    echo "  build it with: (cd \"$HERE\" && pnpm install && pnpm tauri build)" >&2
    exit 1
  fi
  if command -v cargo >/dev/null 2>&1; then
    echo "utter-gui: first run — building the app (this takes a minute)…" >&2
    (cd "$HERE" && pnpm install >/dev/null 2>&1 || true)
    (cd "$HERE" && pnpm build >/dev/null 2>&1 || true)
    (cd "$SRC_TAURI" && cargo build --release >/dev/null 2>&1)
    binary="$SRC_TAURI/target/release/utter"
  fi
fi

if [[ -z "$binary" || ! -x "$binary" ]]; then
  echo "utter-gui: could not find or build the app." >&2
  echo "  install Rust + Node/pnpm, then: (cd \"$HERE\" && pnpm install && pnpm tauri build)" >&2
  exit 1
fi

exec "$binary" "$@"
